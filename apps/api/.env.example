# Copy to .env for local development. Nothing here is a production secret,
# and .env is gitignored (see .gitignore). See README.md for how these are used.

ENVIRONMENT=development

# asyncpg needs postgresql+asyncpg://, not the plain postgresql:// scheme.
DATABASE_URL=postgresql+asyncpg://ileapp:ileapp_dev_local@localhost:5432/ile_dev

# Generate a real value per environment: `openssl rand -hex 32`. This one is a
# placeholder so the app boots locally without a manual step; never reuse it
# past local development.
JWT_SECRET_KEY=dev-only-secret-do-not-use-in-staging-or-production-6f1c2a9d
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ALGORITHM=HS256

# Comma-separated. The Next.js dev server's default port.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookies are only ever Secure outside development (see core/config.py):
# local HTTP has no TLS for the Secure flag to require.
REFRESH_COOKIE_NAME=ile_refresh_token
REFRESH_TOKEN_DAYS=30
